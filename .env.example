# Configuração do Go Next Agendamentos
# Copie este arquivo para .env e preencha os valores

# Firebase Admin (Backend - Opcional)
# Se não configurado, o sistema usará apenas autenticação JWT local
FIREBASE_PROJECT_ID=goNext
FIREBASE_SERVICE_ACCOUNT_PATH=

# Configuração do Firebase Web SDK (Frontend)
FIREBASE_API_KEY=sua_api_key_aqui
FIREBASE_AUTH_DOMAIN=seu_projeto.firebaseapp.com
FIREBASE_STORAGE_BUCKET=seu_projeto.firebasestorage.app
FIREBASE_MESSAGING_SENDER_ID=seu_sender_id
FIREBASE_APP_ID=seu_app_id
FIREBASE_MEASUREMENT_ID=seu_measurement_id

# Servidor
PORT=8080
GIN_MODE=release

# JWT (autenticação local)
JWT_SECRET_KEY=goNext-secret-key-change-in-production
JWT_EXPIRATION_HOURS=168

# Banco de Dados
DB_PATH=./backend/cmd/api/data/goNext.db
