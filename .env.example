# Configuração do Backend - Barbearia Silva
# Copie este arquivo para .env e preencha os valores

# Firebase (opcional)
# Se não configurado, o sistema usará apenas autenticação JWT local
FIREBASE_PROJECT_ID=barbeariahom
FIREBASE_SERVICE_ACCOUNT_PATH=

# Para usar Firebase Auth:
# 1. Baixe o Service Account JSON do Firebase Console:
#    https://console.firebase.google.com/project/barbeariahom/settings/serviceaccounts/adminsdk
# 2. Salve o arquivo em: backend/config/firebase-service-account.json
# 3. Defina o caminho: FIREBASE_SERVICE_ACCOUNT_PATH=./config/firebase-service-account.json

# Servidor
PORT=8080
GIN_MODE=release

# JWT (autenticação local)
JWT_SECRET_KEY=your-super-secret-jwt-key-change-in-production
JWT_EXPIRATION_HOURS=168

# Banco de Dados
DB_PATH=./backend/cmd/api/data/barbearia.db
